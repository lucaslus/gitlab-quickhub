{
  "name": "gitlab-quickhub",
  "version": "3.17.1",
  "description": "Quick access to recent GitLab MR repositories, favorites, search, and branch merge status.",
  "scripts": {
    "check": "node --check src/gitlab-quickhub.user.js && node --check scripts/build.mjs",
    "test": "node --test test/*.test.js && node --test scripts/*.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "userscript": {
    "source": "src/gitlab-quickhub.user.js",
    "output": "gitlab-quickhub.user.js",
    "title": "GitLab QuickHub"
  },
  "engines": {
    "node": ">=22"
  }
}
